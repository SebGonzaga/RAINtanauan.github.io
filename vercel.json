{
  "functions": {
    "api/chat.js": {
      "maxDuration": 30,
      "includeFiles": "assets/js/demo-data.js"
    },
    "api/daily-digest.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/daily-digest",
      "schedule": "0 16 * * *"
    }
  ]
}
